# Aurora's public PACE implementation is not available, and the two candidate
# performance roots in public E3SM/SimBoard sources disagree. Require the native
# ALCF runner to provide reviewed roots rather than silently scanning a guessed
# path. See docs/operations/aurora-ingestion.md.
export SIMBOARD_INGESTOR_MODULE="app.scripts.ingestion.hpc_upload_archive_ingestor"
export SIMBOARD_DEFAULT_ARCHIVE_YEAR_START="${SIMBOARD_DEFAULT_ARCHIVE_YEAR_START:-2025-01}"
export PERF_ARCHIVE_ROOT="${PERF_ARCHIVE_ROOT:-}"
export OLD_PERF_ARCHIVE_ROOT="${OLD_PERF_ARCHIVE_ROOT:-}"
export PERF_SOURCE_ROOT="${PERF_SOURCE_ROOT:-${PERF_ARCHIVE_ROOT}}"
export OLD_PERF_SOURCE_ROOT="${OLD_PERF_SOURCE_ROOT:-${OLD_PERF_ARCHIVE_ROOT}}"
export MACHINE_NAME="${MACHINE_NAME:-aurora}"
# Enable only after adding Aurora to diagnostics_archives.py with verified paths.
export SIMBOARD_DIAGNOSTICS_ENABLED=false
