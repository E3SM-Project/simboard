# Roots match PACE's own collector on Aurora (pace_archive_aurora.sh), which
# archives processed batches to OLD_PERF inside the staging root.
export SIMBOARD_INGESTOR_MODULE="app.scripts.ingestion.hpc_upload_archive_ingestor"
export SIMBOARD_DEFAULT_ARCHIVE_YEAR_START="${SIMBOARD_DEFAULT_ARCHIVE_YEAR_START:-2025-01}"
export PERF_ARCHIVE_ROOT="${PERF_ARCHIVE_ROOT:-/lus/flare/projects/E3SMinput/baselines/performance_archive}"
export OLD_PERF_ARCHIVE_ROOT="${OLD_PERF_ARCHIVE_ROOT:-/lus/flare/projects/E3SMinput/baselines/performance_archive/OLD_PERF}"
export MACHINE_NAME="${MACHINE_NAME:-aurora}"
# Enable only after adding Aurora to diagnostics_archives.py with verified paths.
export SIMBOARD_DIAGNOSTICS_ENABLED=false
