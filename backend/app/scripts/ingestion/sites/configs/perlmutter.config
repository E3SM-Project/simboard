# These are NERSC host paths; Spin must explicitly configure its container mounts.
export SIMBOARD_INGESTOR_MODULE="app.scripts.ingestion.nersc_archive_ingestor"
export MACHINE_NAME="perlmutter"
export PERF_ARCHIVE_ROOT="${PERF_ARCHIVE_ROOT:-/global/cfs/cdirs/e3sm/performance_archive}"
export OLD_PERF_ARCHIVE_ROOT="${OLD_PERF_ARCHIVE_ROOT:-/global/cfs/cdirs/e3sm/OLD_PERF}"
# Routine archive scans share the January 2025 lower bound with other sites.
export SIMBOARD_DEFAULT_ARCHIVE_YEAR_START="${SIMBOARD_DEFAULT_ARCHIVE_YEAR_START:-2025-01}"
