# SimBoard site-ingestion crontab. Copy this file outside the repository,
# replace the placeholders, then install it with: crontab /path/to/<site>.crontab

# =============================================================================
# Cron runtime
# =============================================================================
# Use Bash, a minimal command path, and UTC for every schedule below.
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
CRON_TZ=UTC

# =============================================================================
# Deployment location
# =============================================================================
# Bootstrap location for cron: this is needed to locate the launcher before it
# loads the site config. It must match the standard root in that site config.
SIMBOARD_ROOT=/path/to/simboard_root

# =============================================================================
# Deployment update
# =============================================================================
# Refresh the clean deployment checkout weekly before scheduled scans begin.
# The refresh installs backend dependencies only when the revision changed and
# uses `flock` for a process lock when it is available; review
# simboard-ingestion-provision.log after each update.
0 0 * * 0 PATH="$HOME/.local/bin:$PATH" "${SIMBOARD_ROOT}/repository/simboard/backend/app/scripts/ingestion/sites/operations/refresh_repository.sh" >> "${SIMBOARD_ROOT}/operations/simboard-ingestion-provision.log" 2>&1

# =============================================================================
# API environment and run mode
# =============================================================================
# Each cron command selects its protected API environment file. Both variables
# are exported by that file. Change an individual command to `env.dev.sh` when
# it must target development; keep production jobs on `env.prod.sh`. The
# launcher uses a separate lock for each environment file, so matching
# development and production schedules can run independently.

# The launcher defaults to a dry run. Uncomment only after reviewing dry-run
# logs and enabling live ingestion for this scheduler.
# DRY_RUN=false

# =============================================================================
# Staging scans
# =============================================================================
# Replace `chrysalis` with the site-config name. Scan current performance output
# every 15 minutes for each API environment.

# Development
5,20,35,50 * * * * SIMBOARD_ENV_FILE="${SIMBOARD_ROOT}/operations/env.dev.sh" "${SIMBOARD_ROOT}/repository/simboard/backend/app/scripts/ingestion/sites/site_ingestion_launcher.sh" chrysalis staging
# Production
5,20,35,50 * * * * SIMBOARD_ENV_FILE="${SIMBOARD_ROOT}/operations/env.prod.sh" "${SIMBOARD_ROOT}/repository/simboard/backend/app/scripts/ingestion/sites/site_ingestion_launcher.sh" chrysalis staging

# =============================================================================
# Archive scans
# =============================================================================
# Scan historical archive snapshots daily at 12:00 UTC for each API environment.
# The site config supplies the default lower bound. Set ARCHIVE_YEAR_START or
# ARCHIVE_YEAR_END above these entries for a differently scoped scan; values may
# use YYYY or YYYY-MM.

# Development
0 12 * * * SIMBOARD_ENV_FILE="${SIMBOARD_ROOT}/operations/env.dev.sh" "${SIMBOARD_ROOT}/repository/simboard/backend/app/scripts/ingestion/sites/site_ingestion_launcher.sh" chrysalis archive
# Production
0 12 * * * SIMBOARD_ENV_FILE="${SIMBOARD_ROOT}/operations/env.prod.sh" "${SIMBOARD_ROOT}/repository/simboard/backend/app/scripts/ingestion/sites/site_ingestion_launcher.sh" chrysalis archive
