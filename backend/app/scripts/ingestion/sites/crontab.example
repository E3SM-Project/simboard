# Example crontab entries for a generic site collection launcher. Copy this file
# outside the repository, replace the placeholders, then install the copy with:
#   crontab /path/to/<site>.crontab

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
CRON_TZ=UTC

# Bootstrap location for cron: this is needed to locate the launcher before it
# loads the site config. It must match the standard root in that site config.
SIMBOARD_ROOT=/path/to/simboard_root

# The Chrysalis site config defaults to
# /lcrc/group/e3sm2/simboard/operations/environment.sh. It must be protected
# and export both SIMBOARD_API_BASE_URL and SIMBOARD_API_TOKEN. To target a
# different API environment for this job, uncomment and set this override:
# SIMBOARD_ENV_FILE=${SIMBOARD_ROOT}/operations/environment.production.sh

# Replace `chrysalis` with the site-config name. Staging scan: every 15 minutes.
5,20,35,50 * * * * cd "${SIMBOARD_ROOT}/operations" && "${SIMBOARD_ROOT}/repository/simboard/backend/app/scripts/ingestion/sites/site_ingestion_launcher.sh" chrysalis staging

# Archive scan: run daily at 12:00 UTC. The site config supplies the default
# lower bound. Override `ARCHIVE_YEAR_START` or `ARCHIVE_YEAR_END` in the cron
# environment for a differently scoped scan. Values may use YYYY or YYYY-MM.
0 12 * * * cd "${SIMBOARD_ROOT}/operations" && "${SIMBOARD_ROOT}/repository/simboard/backend/app/scripts/ingestion/sites/site_ingestion_launcher.sh" chrysalis archive
