# Template for protected E3SM v3 Chrysalis backfill configuration.
# `make operations-init-v3-env` uses these defaults to create an environment
# file in the deployment operations directory. Do not commit generated files.
SIMBOARD_API_BASE_URL=""
SIMBOARD_API_TOKEN=""

# Optional: override the default /lcrc/group/e3sm/PERF_Chrysalis/OLD_PERF root.
# OLD_PERF_ARCHIVE_ROOT=/path/to/OLD_PERF

# Optional: override the Chrysalis diagnostic-output source root.
V3_DIAGNOSTICS_SOURCE_ROOT=/lcrc/group/e3sm/public_html/diagnostic_output
